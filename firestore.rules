rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // People allowed to open /admin and read RSVPs (Google sign-in emails).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'maharanay@gmail.com'
        ];
    }

    // Shape check for what the public RSVP form is allowed to write.
    function validRsvp() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'attending', 'adults', 'kids', 'note', 'smsOptIn', 'submittedAt'])
        && d.keys().hasAll(['name', 'phone', 'attending', 'adults', 'kids', 'smsOptIn', 'submittedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.matches('^\\+[0-9]{8,15}$')
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        && d.attending is bool
        && d.smsOptIn is bool
        && d.adults is int && d.adults >= 0 && d.adults <= 20
        && d.kids is int && d.kids >= 0 && d.kids <= 20
        && d.submittedAt == request.time;
    }

    match /rsvps/{rsvpId} {
      // Guests can send or change their reply (same phone number = same RSVP), but never read anyone's.
      allow create, update: if validRsvp();
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
